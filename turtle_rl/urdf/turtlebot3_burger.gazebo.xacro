<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="turtlebot3_burger">

<gazebo>
    <plugin name="gz::sim::systems::DiffDrive" filename="gz-sim-diff-drive-system">
        <left_joint>wheel_left_joint</left_joint>
        <right_joint>wheel_right_joint</right_joint>
        <wheel_separation>0.16</wheel_separation>
        <wheel_radius>0.033</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
    </plugin>

    <plugin name="gz::sim::systems::JointStatePublisher" filename="gz-sim-joint-state-publisher-system"/>
</gazebo>

<gazebo>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
</gazebo>

<gazebo reference="base_scan">
    <sensor name='LDS-02' type='gpu_lidar'>"
        <pose relative_to='base_scan'>0 0 0 0 0 0</pose>
        <topic>scan</topic>
        <!-- See https://emanual.robotis.com/docs/en/platform/turtlebot3/appendix_lds_02/ -->
        <update_rate>5</update_rate>
        <ray>
            <scan>
                <horizontal>
                    <samples>640</samples>
                    <resolution>1</resolution>
                    <min_angle>-3.14</min_angle>
                    <max_angle>3.14</max_angle>
                </horizontal>
            </scan>
            <range>
                <min>0.16</min>
                <max>8.0</max>
                <resolution>0.001</resolution>
            </range>
            <noise>
                <type>gaussian</type>
                <mean>0.0</mean>
                <stddev>0.001</stddev>
            </noise>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
    </sensor>
</gazebo>

</robot>